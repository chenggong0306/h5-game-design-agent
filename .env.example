# LLM 配置 (选择一个)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 或者使用本地 Ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3
# OPENAI_API_KEY=ollama

# 多模型配置（可选）
# LLM_PROVIDER=openai  # 可选: openai / deepseek / qwen / vllm / gemma（后三者都走本地 vLLM/OpenAI 兼容分支）

# 生成质量调参（可选）
# TEMPERATURE：写代码宜偏低，默认 0.3；想要更多玩法/视觉变化可调到 0.5~0.7
# TEMPERATURE=0.3
# MAX_OUTPUT_TOKENS：单次输出上限，务必 ≤ 你的模型真实上限（deepseek-chat≈8192 / gpt-4o≈16384）
# 模型上限更高时可调大以减少分段、生成更完整
# MAX_OUTPUT_TOKENS=8192

# 生成后自检 + 自修闭环（默认开启）：生成游戏后自动质检，发现"看不到/玩不了/报错"就让模型自修后再返回
# SELF_CHECK_ENABLED=true
# SELF_CHECK_MAX_ROUNDS=2   # 最多自修轮数；第 2 轮只在第 1 轮修完仍有问题时才跑
# 无头浏览器运行检查（捕获运行时报错/空屏，更强但需额外安装）：
#   pip install playwright && playwright install chromium   （Linux 还需 playwright install-deps）
# SELF_CHECK_HEADLESS=false

# DeepSeek 配置（可选，用于上下文自动总结；未配置时自动回退到主模型）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 vLLM / OpenAI 兼容部署（Qwen、Gemma 等自托管模型；用 QWEN_* 配置位）
# 启用方式：LLM_PROVIDER=vllm（或 qwen / gemma）
# QWEN_API_KEY=EMPTY                       # vLLM 不校验 key，任意非空字符串即可
# QWEN_BASE_URL=http://localhost:6006/v1   # vllm serve 的地址，注意带 /v1
# QWEN_MODEL=Qwen3.6-35B-A3B-FP8
#
# 示例：gemma-4-31B-it（vllm serve ... --port 6006 --tool-call-parser gemma4 --enable-auto-tool-choice）
# LLM_PROVIDER=vllm
# QWEN_API_KEY=EMPTY
# QWEN_BASE_URL=http://localhost:6006/v1
# QWEN_MODEL=/root/autodl-tmp/models/google/gemma-4-31B-it   # 没设 --served-model-name 时，模型 id = 启动时的路径
# MAX_OUTPUT_TOKENS=16384                   # 128K 上下文，可放大单段输出、减少分段截断
# TEMPERATURE=0.3

# LangSmith tracing（可选，用于查看 LangChain/LangGraph 调用链）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=h5-game-design-agent

# 服务配置
# 默认只绑本机回环（安全）。接口无内置鉴权，切勿在未设 API_TOKEN 时用 0.0.0.0 对外暴露。
HOST=127.0.0.1
PORT=8000
# 生产环境请设为 false（DEBUG=true 会开启 uvicorn reload，仅供开发）
DEBUG=false
# 可选 API 令牌：留空=本机自用、接口开放；设置后 /api/* 写操作需带 X-API-Token 头。
# 若确需 HOST=0.0.0.0 对外暴露，务必同时设置一个强随机 API_TOKEN。
# API_TOKEN=

# 知识库配置
CHROMA_PERSIST_DIR=./data/chroma_db
ASSETS_DIR=./data/assets
SKILLS_DIR=./data/skills
