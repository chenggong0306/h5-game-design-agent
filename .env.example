# LLM 配置 (选择一个)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 或者使用本地 Ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3
# OPENAI_API_KEY=ollama

# 多模型配置（可选）
# LLM_PROVIDER=openai  # 可选: openai / deepseek / qwen

# DeepSeek 配置（必填，用于上下文自动总结）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen/vLLM 本地部署配置
# QWEN_API_KEY=your-qwen-api-key
# QWEN_BASE_URL=http://localhost:6006/v1
# QWEN_MODEL=Qwen3.6-35B-A3B-FP8

# 嵌入模型
EMBEDDING_MODEL=text-embedding-3-small


# LangSmith tracing（可选，用于查看 LangChain/LangGraph 调用链）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=h5-game-design-agent

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 知识库配置
CHROMA_PERSIST_DIR=./data/chroma_db
ASSETS_DIR=./data/assets
SKILLS_DIR=./data/skills
TEMPLATES_DIR=./data/templates
